# ============================================
# SAMVERA — Environment Variables
# ============================================
# Copy this file to .env.local and fill in values
# NEVER commit .env.local to version control
# ============================================

# ── Application ──
NEXT_PUBLIC_APP_NAME=SAMVERA
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ── Database ──
DATABASE_URL="postgresql://user:password@localhost:5432/samvera?schema=public"

# ── Authentication ──
JWT_SECRET=your-jwt-secret-min-32-chars-here
JWT_EXPIRY=7d
REFRESH_TOKEN_SECRET=your-refresh-token-secret-here
REFRESH_TOKEN_EXPIRY=30d

# ── Razorpay ──
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# ── Image Storage (Cloudinary) ──
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── Email (Resend) ──
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=noreply@samvera.com

# ── Admin ──
ADMIN_EMAIL=admin@samvera.com
ADMIN_PASSWORD=change-this-in-production
